urls-source "miniflux"
miniflux-url "https://feed.wantguns.dev"

miniflux-flag-star "a"
miniflux-flag-save "b"
miniflux-show-special-feeds "no"

# general settings
auto-reload yes
max-items 100
text-width 80

# externel browser
browser "w3m -cols 80 %u"

bind-key j down
bind-key k up
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key d pagedown
bind-key u pageup
bind-key l open
bind-key h quit
bind-key a toggle-article-read
bind-key n next-unread
bind-key N prev-unread
bind-key D pb-download
bind-key U show-urls
bind-key x pb-delete

# green theme (matching tmux)
color background         default   default
color listnormal         default   default
color listnormal_unread  color2    default  bold
color listfocus          color0    color2
color listfocus_unread   color0    color2   bold
color info               color2    color0
color article            default   default

highlight feedlist ".*(0/0))" black
highlight article "(^Feed:.*|^Title:.*|^Author:.*)" green default bold
highlight article "(^Link:.*|^Date:.*)" default default
highlight article "https?://[^ ]+" magenta default underline
highlight article "\\[[0-9][0-9]*\\]" cyan default bold
highlight article "\\[image\\ [0-9]+\\]" green default
