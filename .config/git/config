[user]
	email = mail@wantguns.dev
	name = Gunwant Jain
	
[commit]
	template = "~/.config/git/message"

[core]
	editor = nvim

[color]
	ui = auto

[merge]
	tool = vimdiff

[mergetool "vimdiff"]
	path = nvim

[url "git@github.com:"]
	insteadOf = https://github.com/

[init]
	defaultBranch = main
[pull]
	rebase = true
[diff]
	colorMoved = zebra
[gpg]
	format = ssh

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[includeIf "gitdir:~/dev/tensorfuse/"]
    path = "~/dev/tensorfuse/.gitconfig"
